FROM python:3.12-slim AS verify
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY . .
RUN python scripts/validate_repository.py
RUN python -m unittest discover -s tests -v

FROM python:3.12-slim
WORKDIR /app
COPY runtime/ runtime/
COPY state/05_Current_Season_State.md state/05_Current_Season_State.md
COPY scripts/serve_private_runtime.py scripts/serve_private_runtime.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENGINE_BIND_HOST=0.0.0.0
CMD ["python", "scripts/serve_private_runtime.py"]
